# Copia este archivo como ".env" y cambia los valores.

# Gestor a usar: postgres | mysql | sqlserver | oracle
DB_GESTOR=postgres

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ferias
DB_USER=postgres
DB_PASSWORD=postgres

# Puertos por defecto:  postgres 5432 | mysql 3306 | sqlserver 1433 | oracle 1521
# Oracle: DB_NAME es el nombre del servicio (ej: XEPDB1 o FREEPDB1)
# SQL Server: si tu driver ODBC es otro, descomenta y cambia:
# DB_SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
